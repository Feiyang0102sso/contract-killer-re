  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(CkPort)swerve_compat;$(CkPort)include;$(CkSDL)\include;$(CkOpenAL)\include;$(CkUnicorn)include;$(CkThirdParty)\gl-include;$(CkThirdParty)\powervr;$(CkRoot)CK_source\packages\native_sdk_2_0\src\logg\include;$(CkRoot)CK_source\packages\native_sdk_2_0\src\lvorbis\include;%(AdditionalIncludeDirectories);$(CkGameIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>CK_PC;NDEBUG;WIN32;WIN32_LEAN_AND_MEAN;NOMINMAX;_CRT_SECURE_NO_WARNINGS;_CRT_NONSTDC_NO_DEPRECATE;_CRT_STDIO_ISO_WIDE_SPECIFIERS;KHRONOS_STATIC;GL_GLEXT_PROTOTYPES;crc32=ck_zlib_crc32;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <RuntimeTypeInfo>false</RuntimeTypeInfo>
      <BufferSecurityCheck>false</BufferSecurityCheck>
      <ExceptionHandling>false</ExceptionHandling>
      <!-- Source paths begin with ..\ from vs\, so reserve one level under IntDir. -->
      <ObjectFileName>$(IntDir)src\%(RelativeDir)</ObjectFileName>
      <AdditionalOptions>/utf-8 /Zc:sizedDealloc- /clang:-fwrapv /clang:-fno-strict-aliasing /clang:-Wno-c++11-narrowing %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(CkAddressSanitizer)' == 'true'">/fsanitize=address %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
